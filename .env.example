# --- Application ---
APP_ENV=development
APP_PORT=8080

# --- Database (Postgres) ---
DATABASE_URL=postgres://hospital:hospital_dev_password@localhost:5433/hospital_register

# --- Cache / Rate Limiting (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=generate_with_openssl_rand_base64_48
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Logging ---
RUST_LOG=hospital_register=debug,tower_http=debug,sqlx=warn,info